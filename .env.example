# ==============================================================================
# DentPro OS — Single-Clinic Environment Configuration Template
# ==============================================================================
# Each independent clinic deployment must maintain its own isolated environment variables,
# Supabase project, domain, and secrets. Never commit production secrets to Git.
# Copy this file to `.env.local` for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Project Configuration (Unique per clinic)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-clinic-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-clinic-anon-publishable-key

# Server-side Supabase Service Role Key (Used ONLY in Edge Functions & secure server environments)
# WARNING: DO NOT expose with NEXT_PUBLIC_* prefix or place in client-side bundles!
SUPABASE_SERVICE_ROLE_KEY=your-clinic-service-role-key

# ------------------------------------------------------------------------------
# 2. Clinic Branding & Identity Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLINIC_NAME="DentPro Dental Care & Dental Implant Centre"
NEXT_PUBLIC_CLINIC_SHORT_NAME="DentPro Dental Care"
NEXT_PUBLIC_CLINIC_SUBTITLE="& Dental Implant Centre"
NEXT_PUBLIC_CLINIC_TAGLINE="Transforming Smiles, Transforming Lives"
NEXT_PUBLIC_CLINIC_ESTD_YEAR="2011"
NEXT_PUBLIC_CLINIC_EXPERIENCE_YEARS="14"

# ------------------------------------------------------------------------------
# 3. Contact & Location Information
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLINIC_PHONE="098853 49798"
NEXT_PUBLIC_CLINIC_SECONDARY_PHONE="8790349798"
NEXT_PUBLIC_CLINIC_DISPLAY_PHONE="9885349798 / 8790349798"
NEXT_PUBLIC_CLINIC_WHATSAPP="919885349798"
NEXT_PUBLIC_CLINIC_EMAIL="contact@dentproclinic.com"

NEXT_PUBLIC_CLINIC_ADDR_LINE1="3rd Cross St, opposite GMC Balayogi Stadium"
NEXT_PUBLIC_CLINIC_ADDR_LINE2="Zicria Nagar"
NEXT_PUBLIC_CLINIC_CITY="Yanam"
NEXT_PUBLIC_CLINIC_STATE="Andhra Pradesh / Puducherry"
NEXT_PUBLIC_CLINIC_PINCODE="533464"
NEXT_PUBLIC_CLINIC_ADDRESS="3rd Cross St, opposite GMC Balayogi Stadium, Zicria Nagar, Yanam, Andhra Pradesh 533464"
NEXT_PUBLIC_CLINIC_SHORT_ADDRESS="Yanam, Puducherry"

NEXT_PUBLIC_CLINIC_MAPS_EMBED="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3826.969176378418!2d82.21557007579178!3d16.728224521453205!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3a381fed6dbf3fbf%3A0xe54e60e86b404d03!2sGMC%20Balayogi%20Stadium!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin"
NEXT_PUBLIC_CLINIC_MAPS_URL="https://maps.google.com"

